.PHONY: venv run migrate alembic-rev init-db

PYTHON ?= python3.12
VENV ?= venv
MIGRATION_MSG ?= "autogenerated"

# Sanal ortami olusturur / gunceller: make venv
venv:
	$(PYTHON) -m venv $(VENV)
	$(VENV)/bin/pip install --upgrade pip
	$(VENV)/bin/pip install -r requirements.txt

run:
	$(VENV)/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

migrate:
	$(VENV)/bin/alembic -c alembic.ini upgrade head

alembic-rev:
	$(VENV)/bin/alembic -c alembic.ini revision --autogenerate -m $(MIGRATION_MSG)

init-db:
	$(VENV)/bin/python init_db.py
